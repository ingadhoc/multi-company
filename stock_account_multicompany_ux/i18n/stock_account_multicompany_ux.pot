#: model:ir.model.fields,help:stock_account_multicompany_ux.field_product_template__is_cost_shared_from_parent
msgid ""
"True cuando la compañía activa es una branch y la categoría del producto "
"está compartida a branches: el costo debe leerse de la compañía raíz del "
"grupo, no de la branch."
msgstr ""

#. module: stock_account_multicompany_ux
#: model:ir.model.fields,help:stock_account_multicompany_ux.field_product_category__company_has_branches
msgid ""
"True when the active company has branches (child companies). "
"shared_to_branches solo tiene sentido cuando la compañía realmente tiene "
"branches, por eso el campo se oculta en compañías standalone."
msgstr ""

