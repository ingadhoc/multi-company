#. module: stock_account_multicompany_ux
#. odoo-python
#: code:addons/stock_account_multicompany_ux/models/product_category.py:0
msgid ""
"The inventory valuation of %(categories)s is shared to branches by %(root)s."
" Change it on %(root)s, or disable 'Shared Stock Valuation to Branches' "
"there to configure each branch on its own."
msgstr ""

#. module: stock_account_multicompany_ux
#: model_terms:ir.ui.view,arch_db:stock_account_multicompany_ux.product_category_form_view_stock_valuation_shared
msgid ""
"The parent company shares this valuation to its branches. To configure\n"
"                    this branch on its own, disable \"Shared Stock Valuation to Branches\" on\n"
"                    the parent company."
msgstr ""

#. module: stock_account_multicompany_ux
#: model:ir.model.fields,help:stock_account_multicompany_ux.field_product_product__is_cost_shared_from_parent
#: model:ir.model.fields,help:stock_account_multicompany_ux.field_product_template__is_cost_shared_from_parent
msgid ""
"True cuando la compañía activa es una branch y la categoría del producto "
"está compartida a branches: el costo debe leerse de la compañía raíz del "
"grupo, no de la branch."
msgstr ""

#. module: stock_account_multicompany_ux
#: model:ir.model.fields,help:stock_account_multicompany_ux.field_product_category__company_has_branches
msgid ""
"True when the active company has branches (child companies). "
"shared_to_branches solo tiene sentido cuando la compañía realmente tiene "
"branches, por eso el campo se oculta en compañías standalone."
msgstr ""

#. module: stock_account_multicompany_ux
#: model:ir.model.fields,help:stock_account_multicompany_ux.field_product_category__is_branch_company
msgid "True when the active company is a branch (has a parent company)."
msgstr ""

#. module: stock_account_multicompany_ux
#: model:ir.model.fields,help:stock_account_multicompany_ux.field_product_category__is_valuation_shared_from_parent
msgid ""
"True when the active company is a branch and the root company shares this "
"category's valuation: the branch cannot change it."
msgstr ""

#. module: stock_account_multicompany_ux
#: model:ir.model.fields,help:stock_account_multicompany_ux.field_product_category__can_share_to_branches
msgid ""
"True when the active company is a parent with branches and no branch has an "
"active warehouse: its stock lives on the parent and the branches only "
"invoice."
msgstr ""

