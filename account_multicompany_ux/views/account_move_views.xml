<odoo>

    <record id="view_move_form" model="ir.ui.view">
        <field name="model">account.move</field>
        <field name="name">account.move.form</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <label for="journal_id" position="before">
                <label for="company_id" readonly="True" groups="base.group_multi_company"/>
                <div groups="base.group_multi_company">
                    <field name="company_can_change" invisible="1"/>
                    <field name="company_id" readonly="True" class="oe_inline"/>
                    <button name="%(action_account_change_company)d" type="action" invisible="state != 'draft' or posted_before or not company_can_change" icon="fa-pencil" class="btn-link" title="Change Company"  />
                </div>
            </label>

            <!-- Inject computed partner domain (includes parent-company contacts) -->
            <field name="company_id" position="after">
                <field name="partner_id_domain" invisible="1"/>
            </field>

            <!-- Override partner_id domain to include parent-company contacts -->
            <xpath expr="//field[@name='partner_id'][@widget='res_partner_many2one']" position="attributes">
                <attribute name="domain">partner_id_domain</attribute>
            </xpath>

        </field>
    </record>

</odoo>
