<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_property_form" model="ir.ui.view">
        <field name="name">res.partner.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="product.view_partner_property_form"/>
        <field name="arch" type="xml">
            <label for="use_partner_credit_limit">
                <attribute name="groups">!base.group_multi_company</attribute>
            </label>
            <xpath expr="//field[@name='use_partner_credit_limit']/.." position="attributes">
                <attribute name="groups">!base.group_multi_company</attribute>
            </xpath>
            <label for="use_partner_credit_limit" position="before">
                <label for="property_credit_limit_ids" groups="base.group_multi_company"/>
                <div class="oe_inline" name="property_credit_limit_ids" groups="base.group_multi_company">
                    <field name="property_credit_limit_ids" widget="many2many_tags" class="oe_inline" context="{'active_model': 'res.partner', 'active_id': id, 'property_field': 'credit_limit'}"/>
                    <button name="action_company_properties" string="(edit)" class="oe_link" type="object" context="{'property_field': 'credit_limit'}"/>
                </div>
            </label>

            <!-- credit -->
            <field name="credit" position="attributes">
                <attribute name="groups">!base.group_multi_company</attribute>
            </field>

            <field name="credit" position="after">
                <label for="property_credit_ids" groups="base.group_multi_company"/>
                <div class="oe_inline" groups="base.group_multi_company">
                    <field name="property_credit_ids" widget="many2many_tags" context="{'active_model': 'res.partner', 'active_id': id, 'property_field': 'credit'}"/>
                </div>
            </field>
        </field>
    </record>

</odoo>
